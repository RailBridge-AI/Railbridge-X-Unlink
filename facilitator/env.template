# EVM Facilitator Configuration
# For testing: use your dedicated testnet facilitator key.
FACILITATOR_EVM_PRIVATE_KEY=your_evm_private_key_here
FACILITATOR_ADMIN_TOKEN=replace_with_strong_admin_token

# Non-sensitive runtime values are configured in:
# - facilitator/config/runtime-config.json
# - facilitator/config/runtime-config.local.json

# Solana Facilitator Configuration (optional)
SVM_PRIVATE_KEY=your_solana_private_key_base58_here
SVM_RPC_URL=https://api.devnet.solana.com

# Client Configuration (for client-example.ts)
# Your wallet private key for making payments
CLIENT_PRIVATE_KEY=0xYourClientPrivateKeyHere
# Multi-chain client RPC mapping (network -> rpc url)
CLIENT_RPC_OVERRIDES_JSON={"eip155:84532":"https://sepolia.base.org","eip155:421614":"https://arbitrum-sepolia-rpc.publicnode.com"}
# Optional fallback RPC when network is missing from CLIENT_RPC_OVERRIDES_JSON
CLIENT_DEFAULT_RPC_URL=https://sepolia.base.org

# Merchant Server URL (for client examples)
MERCHANT_URL=http://localhost:4021

# Real payment smoke test script (scripts/pay-merchant-os-testnet.ts)
# Uses Merchant OS login/onboarding + API key to spin up demo merchant route and make a real paid request.
# Optional facilitator base URL override (default: http://localhost:4022)
# FACILITATOR_URL=http://localhost:4022
RB_ADMIN_EMAIL=ops@example.com
RB_ADMIN_PASSWORD=replace_with_local_demo_password
RB_MERCHANT_NAME=Spotlight Merchant
RB_MERCHANT_PORT=4025
RB_API_ID=premium_api
RB_API_NAME=Premium API
RB_AMOUNT_USDC=0.01
RB_SOURCE_NETWORK=eip155:84532
RB_PRODUCT_SETTLEMENT_MODE=same_chain
# Optional if cross_chain:
# RB_DEST_NETWORK=eip155:421614
# Optional preferred source network to pay from, if multiple options are offered:
# RB_PAY_NETWORK=eip155:84532

# Existing merchant service payment script (scripts/pay-existing-merchant-testnet.ts)
# Use this when the merchant backend is already running separately.
# Non-sensitive settings come from facilitator/config/payment-test-config.json
# (and optional facilitator/config/payment-test-config.local.json override).
# Optional secret for post-payment settlement verification only (not used by the payer/client request):
# RB_VERIFICATION_API_KEY=
# RB_API_KEY=

# Manual bridge API utility (scripts/manual-bridge-merchant-os.ts)
# Use this only when needed. Your preferred flow can be bridge via frontend.
# RB_REQUIRE_REAL_BRIDGE=true
# RB_BRIDGE_SOURCE_NETWORK=eip155:84532
# RB_BRIDGE_DEST_NETWORK=eip155:421614
# RB_BRIDGE_AMOUNT_USDC=0.005

# Merchant OS demo ingest (optional)
# ingest URL is configured in runtime-config.json
# If MERCHANT_OS_INGEST_TOKEN is set, facilitator can publish settlement events to Merchant OS.
MERCHANT_OS_INGEST_TOKEN=replace_with_same_ingest_token_as_merchant_os

# Merchant-facing demo server config
# Required
RB_API_KEY=
# Optional: set if you want to resolve directly by API ID instead of route method/path.
# Reuses RB_API_ID defined above.
# Optional: local (default, localhost endpoints), testnet, or live.
RB_ENV=local
# Optional override for demos. Leave blank to use the product settlement policy.
RB_SETTLEMENT_MODE_OVERRIDE=
# Optional: cap how many network options are sent in one x402 challenge.
# Keeps headers under size limits when products use sourceNetwork=any.
RB_MAX_REQUIREMENT_OPTIONS=8
