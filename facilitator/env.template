# Server Configuration
PORT=4022

# EVM Facilitator Configuration
# For testing: Use Base Sepolia testnet
# For production: Use mainnet RPC URL
EVM_PRIVATE_KEY=your_evm_private_key_here
EVM_RPC_URL=https://sepolia.base.org

# Facilitator Address (derived from EVM_PRIVATE_KEY, but can be set explicitly)
# This is the address that will receive payments and settle them
# You can find this by running the facilitator - it will print the address on startup
FACILITATOR_ADDRESS=0xYourFacilitatorAddressHere

# Solana Facilitator Configuration (optional)
SVM_PRIVATE_KEY=your_solana_private_key_base58_here
SVM_RPC_URL=https://api.devnet.solana.com

# ERC-4337 Smart Wallet Configuration
# Set to true to enable automatic smart wallet deployment via EIP-6492
DEPLOY_ERC4337_WITH_EIP6492=false

# Cross-Chain Configuration
# Set to false to disable cross-chain bridging (only settle on source chain)
# When disabled: Payment settles on source chain, no bridging occurs
# For testing: Set to false to skip bridging (settle on source chain only)
CROSS_CHAIN_ENABLED=true

# Client Configuration (for client-example.ts)
# Your wallet private key for making payments
CLIENT_PRIVATE_KEY=0xYourClientPrivateKeyHere

# Merchant Server URL (for client examples)
MERCHANT_URL=http://localhost:4021
MERCHANT_OS_API_URL=http://localhost:4030

# Merchant OS demo ingest (optional)
# If set, facilitator publishes settlement events to Merchant OS.
MERCHANT_OS_EVENT_INGEST_URL=http://localhost:4030/v1/demo/internal/events/settlements
MERCHANT_OS_INGEST_TOKEN=merchant-os-demo-ingest
MERCHANT_OS_INTERNAL_TOKEN=merchant-os-demo-ingest

# Merchant OS demo merchant-server route resolver context
MERCHANT_OS_MERCHANT_ID=11111111-1111-4111-8111-111111111111
MERCHANT_OS_ACCOUNT_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
MERCHANT_OS_ROUTE_METHOD=GET
MERCHANT_OS_ROUTE_PATH=/api/premium
MERCHANT_OS_DEMO_SETTLEMENT_MODE=same_chain

# Merchant context mapping for settlement event routing.
# Map destination merchant address -> merchant/account ids from Merchant OS seed data.
# Example:
# MERCHANT_CONTEXT_MAP_JSON={"0x1111111111111111111111111111111111118453":{"merchantId":"11111111-1111-4111-8111-111111111111","accountId":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"},"0x1111111111111111111111111111111111111115":{"merchantId":"11111111-1111-4111-8111-111111111111","accountId":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"},"0x2222222222222222222222222222222222228453":{"merchantId":"22222222-2222-4222-8222-222222222222","accountId":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"},"0x2222222222222222222222222222222222221115":{"merchantId":"22222222-2222-4222-8222-222222222222","accountId":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"}}
MERCHANT_CONTEXT_MAP_JSON=

# Optional default tenant if address is missing in MERCHANT_CONTEXT_MAP_JSON
MERCHANT_OS_DEFAULT_MERCHANT_ID=
MERCHANT_OS_DEFAULT_ACCOUNT_ID=
