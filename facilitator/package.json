{
  "name": "railbridge-facilitator",
  "version": "1.0.0",
  "description": "Cross-chain x402 payment facilitator for RailBridge",
  "type": "module",
  "main": "dist/facilitator-implementation.js",
  "scripts": {
    "dev": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs watch src/facilitator-implementation.ts",
    "build": "tsc",
    "start": "node dist/facilitator-implementation.js",
    "postinstall": "node scripts/link-local-package-deps.mjs",
    "setup:local-sdk-deps": "node scripts/link-local-package-deps.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test:merchant": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs src/merchant-server.ts",
    "test:merchant-os-demo": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs src/merchant-server-merchant-os-demo.ts",
    "test:merchant-os-testnet": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs src/merchant-server-merchant-os-testnet.ts",
    "test:accept-payment-merchant-os": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs scripts/pay-merchant-os-testnet.ts",
    "test:accept-payment-existing-merchant-os": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs scripts/pay-existing-merchant-testnet.ts",
    "test:accept-payment-existing-merchant-public-testnet": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs scripts/pay-existing-merchant-public-testnet.ts",
    "test:bridge-merchant-os": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs scripts/manual-bridge-merchant-os.ts",
    "test:merchant-same-chain": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs src/merchant-server-same-chain.ts",
    "example:client": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs src/client-example.ts",
    "demo:cctp": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs src/integration_demo/usdc_cctp.ts",
    "test:testnets": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs scripts/testnet-coverage.ts",
    "diagnose:domain": "node --preserve-symlinks ./node_modules/tsx/dist/cli.mjs scripts/diagnose-domain.ts"
  },
  "dependencies": {
    "@railbridgeai/merchant-sdk": "file:../packages/server-sdk",
    "@circle-fin/adapter-viem-v2": "^1.2.0",
    "@circle-fin/bridge-kit": "^1.3.0",
    "@scure/base": "^1.2.6",
    "@solana/kit": "^5.3.0",
    "@x402/core": "^2.12.0",
    "@x402/evm": "^2.12.0",
    "@x402/express": "^2.12.0",
    "@x402/fetch": "^2.12.0",
    "@x402/paywall": "^2.12.0",
    "@x402/svm": "^2.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "viem": "^2.44.4"
  },
  "overrides": {
    "bn.js": "4.12.3",
    "ws": "7.5.10"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "x402",
    "payment",
    "cross-chain",
    "facilitator",
    "railbridge"
  ],
  "author": "",
  "license": "MIT"
}
