# Required: Merchant API key from Merchant OS Settings -> API Keys.
RB_API_KEY=replace_with_testnet_merchant_api_key

# Optional: specific API product id configured in Merchant OS.
# RB_API_ID=premium_api

# Optional: force settlement mode for route requirements.
# RB_SETTLEMENT_MODE_OVERRIDE=cross_chain

# Public RailBridge testnet endpoints for external-integration simulation.
RB_FACILITATOR_URL=https://facilitator.testnet.railbridge.ai
RB_MERCHANT_OS_API_URL=https://api.testnet.railbridge.ai

# Demo merchant HTTP server port inside container.
PORT=4021

# Optional limit for challenge requirement choices.
RB_MAX_PAYMENT_OPTIONS=32
