FROM node:22-bookworm-slim AS deps
WORKDIR /app/merchant-os
COPY merchant-os/package.json merchant-os/package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-bookworm-slim AS runner
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates sqlite3 tini \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app/merchant-os

COPY --from=deps /app/merchant-os/node_modules ./node_modules
COPY merchant-os ./

ENV NODE_ENV=production
EXPOSE 4030

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "src/server.js"]

