# RailBridge Merchant OS uses two config layers:
# 1) Non-sensitive runtime config in `config/runtime-config.json` (or local override file).
# 2) Sensitive values in `.env`.

# Required internal/service secrets
MERCHANT_OS_INGEST_TOKEN=replace_with_strong_ingest_token
MERCHANT_OS_INTERNAL_TOKEN=replace_with_strong_internal_token
MERCHANT_OS_ADMIN_TOKEN=replace_with_strong_admin_token

# Required custody key material
MERCHANT_OS_CUSTODY_MASTER_KEY=0xYour64HexCharsCustodyMasterKeyHere

# Optional signer key
MERCHANT_OS_GAS_SPONSOR_PRIVATE_KEY=0xYourGasSponsorPrivateKeyHere

# Non-secret runtime values (ports, URLs, chain/rpc/timeouts, feature toggles)
# must be configured in config/runtime-config.json or config/runtime-config.local.json.
