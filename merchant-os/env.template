MERCHANT_OS_PORT=4030
MERCHANT_OS_WEB_URL=http://localhost:3000
MERCHANT_OS_DB_PATH=./data/merchant-os.db
MERCHANT_OS_SESSION_HOURS=24
MERCHANT_OS_INGEST_TOKEN=merchant-os-demo-ingest
MERCHANT_OS_INTERNAL_TOKEN=merchant-os-demo-ingest
MERCHANT_OS_CUSTODY_MASTER_KEY=0xYour64HexCharsCustodyMasterKeyHere
# Optional seed signer used for initial custody wallet generation (fallbacks to random per tenant if omitted).
MERCHANT_OS_BRIDGE_EVM_PRIVATE_KEY=0xYourBridgeSignerPrivateKeyHere
# Optional sponsor wallet for automatic native-gas top-ups before bridge execution.
MERCHANT_OS_GAS_SPONSOR_PRIVATE_KEY=0xYourGasSponsorPrivateKeyHere
MERCHANT_OS_GAS_SPONSOR_AUTO_TOPUP=true
# Dynamic estimator uses live eth_gasPrice and these gas-unit budgets.
MERCHANT_OS_GAS_ESTIMATOR_ENABLED=true
MERCHANT_OS_GAS_ESTIMATOR_SOURCE_GAS_UNITS=450000
MERCHANT_OS_GAS_ESTIMATOR_DESTINATION_GAS_UNITS=350000
# Safety multiplier in basis points (18000 = 1.8x).
MERCHANT_OS_GAS_ESTIMATOR_BUFFER_BPS=18000
# Static fallback minimum if gas price cannot be fetched.
MERCHANT_OS_MIN_BRIDGE_NATIVE_BALANCE_WEI=100000000000000
# Optional floor top-up amount (still used with dynamic estimator).
MERCHANT_OS_GAS_SPONSOR_TOPUP_WEI=300000000000000
MERCHANT_OS_GAS_SPONSOR_RECEIPT_TIMEOUT_MS=120000
# Optional legacy override; if omitted, custody address is derived from bridge private key when available.
MERCHANT_OS_CUSTODY_EVM_ADDRESS=0xYourBridgeSignerAddressHere
MERCHANT_OS_REAL_CONSOLIDATION_BRIDGE=true
MERCHANT_OS_CONSOLIDATION_BRIDGE_TIMEOUT_MS=300000
MERCHANT_OS_CONSOLIDATION_BRIDGE_RETRY_ATTEMPTS=2
MERCHANT_OS_CONSOLIDATION_BRIDGE_RETRY_BACKOFF_MS=2500
MERCHANT_OS_CONSOLIDATION_BRIDGE_RPC_TIMEOUT_MS=30000
MERCHANT_OS_CONSOLIDATION_BRIDGE_RPC_RETRY_COUNT=3
MERCHANT_OS_FACILITATOR_ADDRESS=0xYourFacilitatorAddressHere
MERCHANT_OS_DEMO_SOURCE_NETWORK=eip155:421614
MERCHANT_OS_ONCHAIN_TIMEOUT_MS=7000
MERCHANT_OS_ONCHAIN_TOTAL_BUDGET_MS=2200
# RPC + USDC token metadata are hardcoded in src/config.js.
