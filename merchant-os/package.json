{
  "name": "railbridge-merchant-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Merchant Treasury OS demo app (USDC-only, custodial model)",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "dev:api": "node --watch src/server.js",
    "start:api": "node src/server.js",
    "dev:web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "start:web": "npm --prefix frontend run start",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "db:reset": "node scripts/reset-db.js",
    "db:seed": "node scripts/seed-demo.js",
    "demo:quick": "node scripts/demo-quick.js",
    "demo:webhook:service": "node scripts/demo-webhook-service.js",
    "tokens:generate": "node scripts/generate-platform-tokens.js"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.2.0",
    "@circle-fin/bridge-kit": "^1.3.0",
    "viem": "^2.44.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "railbridge",
    "merchant-os",
    "treasury",
    "demo"
  ],
  "license": "MIT"
}
